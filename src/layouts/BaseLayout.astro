---
import { ViewTransitions } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  /** Bare mode: full-bleed page with no Header/Footer and no width constraint. */
  bare?: boolean;
}

const { title, description, image, type, publishedTime, tags, bare = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <ViewTransitions />
    <script is:inline>
      // Prevent theme flash - runs before page renders
      (function() {
        const theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    {bare ? (
      <slot />
    ) : (
      <Fragment>
        <Header />
        <main class="flex-1 max-w-4xl mx-auto px-4 py-8 w-full">
          <slot />
        </main>
        <Footer />
      </Fragment>
    )}
  </body>
</html>
